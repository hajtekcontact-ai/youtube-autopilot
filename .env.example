# YouTube AI Autopilot Cloud
# ========================
# نظام آلي كامل لإنتاج ونشر فيديوهات يوتيوب باستخدام الذكاء الاصطناعي

# Environment Variables Template
# Copy to .env and fill in your values
# لا تضع هذا الملف في Git — استخدم .env.example فقط

# ==========================================
# YouTube OAuth 2.0 Credentials
# ==========================================
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/oauth/callback

# ==========================================
# Gemini API (Optional - for AI content)
# ==========================================
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ==========================================
# Dashboard Admin
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
DASHBOARD_SECRET_KEY=

# ==========================================
# Application Settings
# ==========================================
APP_ENV=production
APP_DEBUG=false
DATABASE_URL=sqlite:///data/autopilot.db
TIMEZONE=America/New_York

# ==========================================
# Content Settings
# ==========================================
CHANNEL_NICHE=science_technology_education
CONTENT_LANGUAGE=en-US
TTS_VOICE=en-US-GuyNeural
SHORTS_PER_DAY=4
LONG_VIDEOS_PER_DAY=1

# ==========================================
# Cloud / GitHub Actions
# ==========================================
GITHUB_REPO=
GITHUB_TOKEN=

# ==========================================
# Notification (Optional)
# ==========================================
NOTIFICATION_EMAIL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==========================================
# Security
# ==========================================
ENCRYPTION_KEY=
EMERGENCY_STOP=false
COST_KILL_SWITCH=false
MAX_DAILY_API_COST_USD=0.00
